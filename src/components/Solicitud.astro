---
// Solicitud de repuesto: arma un mensaje de WhatsApp con los datos del vehículo.
// No simula un inventario en línea y así se dice. Se usa en la portada y en las páginas del
// catálogo: allí las fichas («Cotizar este repuesto») lo llenan con el sistema y la pieza.
// · Validación propia (texto + ícono, nunca solo color), errores con aria-describedby.
// · Los datos se guardan en la sesión del navegador: si vuelves de WhatsApp, siguen ahí.
// · Sin JavaScript el botón no puede componer el mensaje; queda un enlace directo.
// La lógica vive en src/scripts/solicitud.ts; el mensaje, en src/lib/whatsapp.ts.
import Icono from './Icono.astro';
import { WA } from '@/lib/whatsapp';
import { MARCA, WHATSAPP_E164 } from '@/lib/contacto';
import { REPUESTOS } from '@/data/repuestos';

interface Props {
  titulo?: string;
  entrada?: string;
  /** Tipo marcado de entrada (página de un sistema). */
  tipoInicial?: 'Suspensión' | 'Frenos' | 'Motor';
}
const {
  titulo = 'Cotiza tu repuesto por WhatsApp',
  entrada = 'Completa los datos de tu vehículo y te llevamos a WhatsApp con el mensaje listo para enviar.',
  tipoInicial,
} = Astro.props;

const TIPOS = [
  { valor: 'Suspensión', icono: 'suspension' },
  { valor: 'Frenos', icono: 'frenos' },
  { valor: 'Motor', icono: 'motor' },
] as const;
const anioMax = new Date().getFullYear() + 1;
---

<section id="cotizar" class="seccion sol sup-oscuro" aria-labelledby="sol-titulo">
  <div class="contenedor sol__grid">
    <div class="sol__intro">
      <p class="rotulo revela"><span class="trazo"></span>Solicitud de repuesto</p>
      <h2 id="sol-titulo" class="titulo titulo--2 revela">{titulo}</h2>
      <p class="entrada revela" style="--orden:1">{entrada}</p>
      <p class="sol__nota revela" id="sol-nota" style="--orden:2">
        <Icono nombre="alerta" />
        <span>
          Esto es una solicitud de cotización, no una tienda en línea: no consultamos un inventario automático. El equipo
          revisa tu mensaje y te orienta con la referencia y el precio.
        </span>
      </p>

      <figure class="ticket revela" style="--orden:3" aria-labelledby="ticket-titulo">
        <figcaption id="ticket-titulo" class="ticket__cabeza">
          <span>Vista previa del mensaje</span>
          <span class="ticket__para">Para: {MARCA.nombre}</span>
        </figcaption>
        <pre class="ticket__cuerpo" data-ticket="solicitud">{`Hola, ${MARCA.nombre}. Quiero consultar disponibilidad de un repuesto.
Tipo: ${tipoInicial ?? "____"}.
Marca del vehículo: ____.
Modelo: ____.
Año: ____.
¿Me pueden ayudar con la referencia y el precio?`}</pre>
      </figure>
    </div>

    <form class="form revela" id="solicitud" data-solicitud="cotizar" novalidate aria-describedby="sol-nota" data-numero={WHATSAPP_E164} data-anio-max={anioMax} data-tipo-inicial={tipoInicial}>
      <p class="form__resumen" role="alert" data-resumen hidden></p>
      <p class="form__aviso" role="status" data-aviso hidden></p>

      <fieldset class="campo campo--tipo" aria-describedby="e-tipo">
        <legend class="campo__etiqueta"><span class="num">01</span> Tipo de repuesto</legend>
        <div class="opciones">
          {
            TIPOS.map((t) => (
              <label class="opcion">
                <input type="radio" name="tipo" value={t.valor} required checked={t.valor === tipoInicial} />
                <span class="opcion__caja">
                  <Icono nombre={t.icono} />
                  {t.valor}
                </span>
              </label>
            ))
          }
        </div>
        <p class="campo__error" id="e-tipo" data-error="tipo" hidden></p>
      </fieldset>

      <div class="campo">
        <label class="campo__etiqueta" for="f-repuesto">
          <span class="num">02</span> Repuesto que buscas <span class="campo__opcional">(opcional)</span>
        </label>
        <input class="campo__control" id="f-repuesto" name="repuesto" type="text" maxlength="60" autocomplete="off" list="lista-repuestos" placeholder="Ej.: amortiguadores" />
        <datalist id="lista-repuestos">{REPUESTOS.map((r) => <option value={r.nombre} />)}</datalist>
      </div>

      <div class="form__fila">
        <div class="campo">
          <label class="campo__etiqueta" for="f-marca"><span class="num">03</span> Marca del vehículo</label>
          <input class="campo__control" id="f-marca" name="marca" type="text" required maxlength="30" autocomplete="off" autocapitalize="words" spellcheck="false" aria-describedby="e-marca" />
          <p class="campo__error" id="e-marca" data-error="marca" hidden></p>
        </div>
        <div class="campo">
          <label class="campo__etiqueta" for="f-modelo"><span class="num">04</span> Modelo</label>
          <input class="campo__control" id="f-modelo" name="modelo" type="text" required maxlength="40" autocomplete="off" autocapitalize="words" spellcheck="false" aria-describedby="e-modelo" />
          <p class="campo__error" id="e-modelo" data-error="modelo" hidden></p>
        </div>
      </div>

      <div class="campo campo--anio">
        <label class="campo__etiqueta" for="f-anio"><span class="num">05</span> Año</label>
        <input class="campo__control num" id="f-anio" name="anio" type="text" inputmode="numeric" required maxlength="4" pattern="[0-9]{4}" autocomplete="off" placeholder="Ej.: 2015" aria-describedby="e-anio" />
        <p class="campo__error" id="e-anio" data-error="anio" hidden></p>
      </div>

      <div class="campo">
        <label class="campo__etiqueta" for="f-detalle">
          <span class="num">06</span> Detalle <span class="campo__opcional">(opcional)</span>
        </label>
        <textarea class="campo__control campo__control--area" id="f-detalle" name="detalle" rows="3" maxlength="280" placeholder="Ej.: trasero, lado derecho, versión del motor" aria-describedby="c-detalle"></textarea>
        <p class="campo__ayuda num" id="c-detalle" data-contador aria-live="off">0 / 280</p>
      </div>

      <label class="campo--foto">
        <input type="checkbox" name="foto" />
        <span>
          <strong>Tengo una foto del repuesto</strong>
          <span>La adjuntas en el chat de WhatsApp después de enviar el mensaje; así lo ubicamos más rápido.</span>
        </span>
      </label>

      <div class="form__envio">
        <button class="btn btn--primario form__boton" type="submit" data-enviar>
          <Icono nombre="whatsapp" />
          <span data-enviar-texto>Enviar solicitud por WhatsApp</span>
        </button>
        <p class="form__estado" role="status" data-estado></p>
        <noscript>
          <p class="form__estado">
            Para armar el mensaje se necesita JavaScript.
            <a href={WA.general} target="_blank" rel="noopener">Escríbenos directamente por WhatsApp</a>.
          </p>
        </noscript>
      </div>
    </form>
  </div>
</section>

<style>
  .sol {
    background: var(--grafito);
    border-top: 1px solid var(--acero);
  }
  .sol__grid {
    display: grid;
    gap: var(--s-7);
  }
  .sol__intro {
    display: grid;
    align-content: start;
    gap: var(--s-4);
  }
  .sol__intro .titulo {
    max-width: 13ch;
  }
  .sol__nota {
    display: flex;
    gap: var(--s-3);
    max-width: 52ch;
    padding: var(--s-4);
    border-left: 2px solid var(--azul-vivo);
    background: var(--grafito-2);
    font-size: var(--t-sm);
    color: var(--plata);
  }
  .sol__nota .icono {
    width: 20px;
    height: 20px;
    color: var(--azul-luz);
  }

  /* Vista previa: hoja técnica del mensaje que se enviará. */
  .ticket {
    display: none;
    margin-top: var(--s-4);
    border: 1px solid var(--acero);
    background:
      linear-gradient(var(--acero), var(--acero)) 0 44px / 100% 1px no-repeat,
      var(--grafito-0);
  }
  .ticket__cabeza {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    height: 44px;
    align-items: center;
    padding: 0 var(--s-4);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--titanio);
  }
  .ticket__para {
    color: var(--azul-luz);
    letter-spacing: 0.08em;
  }
  .ticket__cuerpo {
    margin: 0;
    padding: var(--s-5) var(--s-4);
    font-family: var(--font-text);
    font-size: var(--t-sm);
    line-height: 1.75;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--plata);
  }

  @media (min-width: 1024px) {
    .sol__grid {
      grid-template-columns: 5fr 6fr;
      gap: clamp(48px, 6vw, 96px);
      align-items: start;
    }
    .sol__intro {
      position: sticky;
      top: calc(var(--header-h) + var(--s-6));
    }
    .ticket {
      display: block;
    }
  }
</style>
