---
import Base from '@/layouts/Base.astro';
import Icono from '@/components/Icono.astro';
import { WA } from '@/lib/whatsapp';
---

<Base title="Página no encontrada | Serna Repuestos" description="La página que buscas no existe." noindex>
  <section class="seccion sup-oscuro nf" aria-labelledby="nf-titulo">
    <div class="contenedor nf__cuerpo">
      <p class="rotulo"><span class="trazo"></span>Error 404</p>
      <h1 id="nf-titulo" class="titulo titulo--2">Esta página no existe</h1>
      <p class="entrada">Puede que el enlace esté mal escrito. Vuelve al inicio o consúltanos directamente.</p>
      <div class="nf__acciones">
        <a class="btn btn--primario" href="/">Ir al inicio</a>
        <a class="btn btn--secundario" href={WA.general} target="_blank" rel="noopener" data-cta="404">
          <Icono nombre="whatsapp" />
          Consultar por WhatsApp
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 80vh;
    display: grid;
    align-items: center;
    padding-top: calc(var(--header-h) + var(--sec));
  }
  .nf__cuerpo {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }
  .nf__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }
</style>
